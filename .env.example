# App Configuration
NEXT_PUBLIC_APP_NAME="SAP Integration Marketplace"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase Configuration (never commit real values)
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Legacy aliases retained only for compatibility with older local tooling
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key

# Razorpay Configuration (Stage 10 payment provider — required for escrow)
# Route is India-only and settles in INR. All three are required at runtime.
# The provider fails closed with HTTP 503 PAYMENT_PROVIDER_UNAVAILABLE when
# RAZORPAY_KEY_ID or RAZORPAY_KEY_SECRET is absent, and refuses to verify any
# webhook when RAZORPAY_WEBHOOK_SECRET is absent, so a misconfigured deployment
# cannot accept unsigned payment events. Never commit real values.
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Stripe Configuration (pre-Stage 10, retained for rollback only; unused)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email Configuration (for future email integration)
SENDGRID_API_KEY=SG.xxx
EMAIL_FROM=noreply@sapintegration.com

# Feature Flags
NEXT_PUBLIC_ENABLE_REGISTRATION=true
NEXT_PUBLIC_ENABLE_MESSAGING=true

# Admin Configuration

# Sentry (for future error tracking)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
